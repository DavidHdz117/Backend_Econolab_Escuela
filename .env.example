NODE_ENV=production
PORT=3000
APP_TRUST_PROXY=1
APP_ENABLE_HSTS=true
COOKIE_SECURE=true

CORS_ORIGINS=https://econolabe.netlify.app
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
CSRF_COOKIE_NAME=__Host-econolab-csrf
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_SECRET_SALT=replace-with-a-random-secret

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app_user
DATABASE_PASS=replace-with-a-secure-password
DATABASE_NAME=econolab
DATABASE_SSL=true
DATABASE_LOGGING=false
DATABASE_SYNCHRONIZE=false
DATABASE_OPERATIVE_SCHEMA=operativo
DATABASE_ADMIN_USER=db_admin
DATABASE_ADMIN_PASS=replace-with-a-secure-password
DATABASE_RECEPCIONISTA_USER=db_recepcionista
DATABASE_RECEPCIONISTA_PASS=replace-with-a-secure-password

JWT_SECRET=replace-with-a-long-random-secret
GMAIL_USER=example@gmail.com
GMAIL_PASS=app-password
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
FRONTEND_URL=https://econolabe.netlify.app
